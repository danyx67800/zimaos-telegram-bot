# Token del bot Telegram (ottenuto da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AA...token...

# ID utente autorizzati ad usare il bot, separati da virgola.
# Trova il tuo ID scrivendo a @userinfobot su Telegram.
ALLOWED_USER_IDS=123456789,987654321

# Percorso del database SQLite. Dentro il container usa /data/bot.db
# (montato come volume per la persistenza).
DB_PATH=/data/bot.db

# Timeout (in secondi) per il comando /ping.
PING_TIMEOUT=5

# Livello di log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
