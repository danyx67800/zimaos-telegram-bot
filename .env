# ⚠️ ATTENZIONE: questo file è tracciato su Git perché lo store ZimaOS/CasaOS
# lo richiede per popolare i campi di configurazione all'installazione.
# Contiene solo valori DI DEFAULT: NON inserire qui il token reale prima di
# un commit/push. Compila i valori dall'interfaccia di ZimaOS, oppure edita
# questo file solo in locale (senza committare).

# Token del bot Telegram (obbligatorio, da @BotFather)
TELEGRAM_BOT_TOKEN=

# ID utente autorizzati, separati da virgola (obbligatorio)
ALLOWED_USER_IDS=

# Percorso del database SQLite dentro il container
DB_PATH=/data/bot.db

# Timeout del comando /ping (secondi)
PING_TIMEOUT=5

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
